{
  "name": "sonos-discovery",
  "version": "1.8.0",
  "description": "A simple node library for managing your Sonos system",
  "author": "Jimmy Shimizu <jimmy@shimizu.se>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jishi/node-sonos-discovery.git"
  },
  "dependencies": {
    "html-entities": "1.0.x",
    "xml-flow": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "chai": "*",
    "jscs": "^3.0.7",
    "jshint": "~2.8.0",
    "mocha": "^4.0.1",
    "proxyquire": "^1.7.3",
    "rewire": "^2.5.1",
    "sinon": "^1.17.2",
    "sinon-as-promised": "^4.0.0",
    "sinon-chai": "^2.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "main": "lib/SonosSystem.js",
  "scripts": {
    "jscs": "jscs lib test",
